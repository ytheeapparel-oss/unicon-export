# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key-or-anon-key

# Optional: Supabase Service Role Key (bypasses Row-Level Security for server API routes)
# Find in: Supabase Dashboard > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Transactional Email Configuration (Resend)
# Get your free API key at: https://resend.com (gives 3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key_here

# Notification recipient (defaults to uniconexport@gmail.com)
ADMIN_NOTIFICATION_EMAIL=uniconexport@gmail.com

# Sender email:
# During initial testing, you can use: UNICON LEATHER Export Desk <onboarding@resend.dev>
# When your custom domain is verified in Resend, use: UNICON LEATHER Export Desk <export@uniconleather.com>
RESEND_FROM_EMAIL=UNICON LEATHER Export Desk <onboarding@resend.dev>
